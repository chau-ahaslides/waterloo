{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waterloo",
  "compatibility_date": "2026-06-01",
  "main": "worker/index.ts",
  "assets": {
    // Vite emits the built SPA here; `wrangler deploy` uploads it.
    "directory": "./dist",
    // Lets the Worker fall back to serving assets via env.ASSETS.fetch().
    "binding": "ASSETS",
    // Unmatched client-side routes (e.g. /dashboard) serve index.html with 200.
    "not_found_handling": "single-page-application",
    // Only /api/* is routed to the Worker; everything else is served as a
    // static asset (with SPA fallback) without invoking the Worker at all.
    "run_worker_first": ["/api/*"]
  },
  // D1 database that persists audience lesson attempts (WAT-5). Bound as
  // `env.DB`. Schema lives in migrations/; apply with:
  //   npx wrangler d1 migrations apply waterloo-lessons            (local)
  //   npx wrangler d1 migrations apply waterloo-lessons --remote   (deployed)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waterloo-lessons",
      "database_id": "175bbb2b-0de3-4ea5-8813-19b7647b933e"
    }
  ],
  // Workers AI binding (WAT-9). Bound as `env.AI`; used by POST
  // /api/lessons/convert to generate grounded multiple-choice questions from a
  // presentation's text. Model: @cf/meta/llama-3.3-70b-instruct-fp8-fast.
  "ai": {
    "binding": "AI",
    // Workers AI always accesses remote resources; this suppresses the local-dev
    // warning and makes the remote access explicit.
    "remote": true
  },
  "observability": {
    "enabled": true
  }
}
