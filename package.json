{
  "name": "waterloo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Vue 3 + Ant Design Vue app styled with the AhaSlides design-token theme.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "cf:dev": "npm run build && wrangler dev",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "ant-design-vue": "^4.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^7.3.3",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.95.0"
  }
}
