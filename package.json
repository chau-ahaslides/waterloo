{
  "name": "waterloo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Vue 3 + Ant Design Vue app styled with the AhaSlides design-token theme.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "cf:dev": "npm run build && wrangler dev",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:worker": "vitest run --project workers",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "ant-design-vue": "^4.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.95.0"
  }
}
